{
  "name": "@pathfinder/shared",
  "version": "0.2.0-alpha.1",
  "description": "Shared TypeScript types for Pathfinder",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "kubb",
    "check:generated": "kubb && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.95.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@kubb/cli": "^4.39.3",
    "@kubb/core": "^4.39.3",
    "@kubb/plugin-oas": "^4.39.3",
    "@kubb/plugin-react-query": "^4.39.3",
    "@kubb/plugin-ts": "^4.39.3",
    "@kubb/plugin-zod": "^4.39.3",
    "@kubb/react-fabric": "^0.16.1",
    "@tanstack/react-query": "^5.102.8",
    "@types/node": "^26.4.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "zod": "^4.5.4"
  },
  "exports": {
    ".": "./src/index.ts",
    "./generated/*": "./src/generated/*"
  }
}

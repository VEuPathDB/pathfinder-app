{
  "_doc": "Shared FE/BE parity fixtures for graph operation appliers. Each case asserts both implementations produce the same post-state for the same op against the same initial graph. Edit both tests when adding cases. combine_labels holds the name each operator gives a combine that no researcher named; retired_combine_labels holds the names an earlier release gave, which are not a researcher's either.",
  "cases": [
    {
      "name": "delete-leaf-of-nested-combine-collapse",
      "initial": {
        "steps": [
          {
            "id": "A",
            "kind": "search"
          },
          {
            "id": "B",
            "kind": "search"
          },
          {
            "id": "D",
            "kind": "search"
          },
          {
            "id": "C",
            "kind": "combine",
            "primaryInputStepId": "A",
            "secondaryInputStepId": "B"
          },
          {
            "id": "R",
            "kind": "combine",
            "primaryInputStepId": "C",
            "secondaryInputStepId": "D"
          }
        ],
        "rootStepId": "R"
      },
      "op": {
        "kind": "deleteStep",
        "stepId": "A",
        "resolution": "collapse-combine"
      },
      "expected": {
        "stepIds": [
          "B",
          "D",
          "R"
        ],
        "rootInputs": {
          "R": {
            "primary": "B",
            "secondary": "D"
          }
        },
        "droppedStepIds": [
          "A",
          "C"
        ]
      }
    },

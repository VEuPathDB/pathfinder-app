# The environment every PathFinder unit on cedar reads.
#
# Copy this file to ~/.config/pathfinder/.env on the host and fill in the
# values there. Names only live here; no value of this deployment is ever
# committed.
#
#   mkdir -p ~/.config/pathfinder
#   cp deploy/cedar/env.example ~/.config/pathfinder/.env
#   chmod 600 ~/.config/pathfinder/.env
#
# One file serves the api, the worker, the two MCP servers and the metasearch,
# so every name here is global. The unit files already state what belongs to
# the container network: DATABASE_URL, CATALOG_CACHE_DIR, both MCP endpoints,
# the metasearch URL, the strategy name prefix and the refresh switches. A
# value set here for one of those is overridden by the unit.

# ---- Core runtime (required) ----
# The value is production. The tester deployment is not a development stack.
API_ENV=
# Signs this deployment's own tokens. 32 characters or more, random, private.
API_SECRET_KEY=
# The value is default. Only a test stack runs the mock provider.
PATHFINDER_CHAT_PROVIDER=

# ---- Models (at least one provider key is required) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# An OpenAI-compatible base URL, for a local model server.
OLLAMA_BASE_URL=
# The provider and the tier a turn runs on when the user picks neither.
DEFAULT_PROVIDER=
DEFAULT_TIER=
# One model name per provider, to override the catalog default.
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=

# ---- Screening (optional) ----
# false skips the injection judge on the user's message and on tool results.
INPUT_SCREENING_ENABLED=
# The model one judgement runs on.
INPUT_SCREENING_MODEL=

# ---- VEuPathDB (required) ----
# The service account token for user-independent reads: record types, searches
# and parameter metadata.
VEUPATHDB_AUTH_TOKEN=
# The OAuth server whose JWKS verifies a user's bearer token.
VEUPATHDB_OAUTH_URL=
# A path inside the container to a sites file, to serve fewer sites than the
# library ships.
VEUPATHDB_SITES_CONFIG=

# ---- Tool servers (required for the tools they serve) ----
# The credential the api and the worker present at each server. The same secret
# must appear in that server's own service-token list, and an empty one admits
# nothing.
PATHFINDER_WDK_MCP_TOKEN=
PATHFINDER_RESEARCH_MCP_TOKEN=
# The applications each server admits, as "app_id:secret[,app_id:secret...]".
WDK_MCP_SERVICE_TOKENS=
RESEARCH_MCP_SERVICE_TOKENS=
# The URL a client reads each server's RFC 9728 document at. It must be
# reachable by the client, which here is another container on this network:
# http://pathfinder-wdk-mcp:8100 and http://pathfinder-research-mcp:8110.
WDK_MCP_BASE_URL=
RESEARCH_MCP_BASE_URL=
# Signs the metasearch cookies inside the stack: any long random string.
SEARXNG_SECRET=
# The literature and web-search keys the research server reads. Semantic
# Scholar is read under S2_API_KEY by the api and under the prefixed name by
# the research server, so both are set.
S2_API_KEY=
RESEARCH_MCP_S2_API_KEY=
RESEARCH_MCP_BRAVE_SEARCH_API_KEY=
# A mailbox Crossref reads out of the User-Agent, which routes the call to its
# polite pool.
RESEARCH_MCP_CROSSREF_MAILTO=

# ---- Applications calling PathFinder (optional) ----
# Service identities for callers of this api, as "app_id:secret[,...]".
PATHFINDER_SERVICE_TOKENS=
# Browser origins the api answers. The tester URL is one origin; the tunnel is
# another.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# ---- Sites and catalogs (optional) ----
# Megabytes of per-site catalogs and indexes one process holds before the least
# recently used site is evicted.
SITE_CATALOG_BUDGET_MB=
# The budget for one site's catalog load, and the gap between two passes over
# the sites that did not load.
SITE_PRELOAD_TIMEOUT_SECONDS=
SITE_RETRY_INTERVAL_SECONDS=

# ---- Turns and streams (optional) ----
# Tokens the Lead's own run may spend in one turn.
LEAD_TURN_TOKEN_LIMIT=
# Seconds of silence after which the chat stream sends a comment frame, so no
# proxy drops an idle stream.
SSE_KEEPALIVE_SECONDS=

# ---- Worker (optional) ----
# Jobs the worker runs in parallel, across every queue.
WORKER_CONCURRENCY=
# Age at which a job still in 'doing' is failed so its lock releases.
WORKER_STALLED_JOB_TIMEOUT_SECONDS=
# Seconds between two worker heartbeats, and the silence after which a worker
# counts as dead and its turn is failed. The api reads the second one too.
WORKER_HEARTBEAT_INTERVAL_SECONDS=
WORKER_DEAD_HEARTBEAT_SECONDS=

# ---- Logs and traces (optional) ----
LOG_LEVEL=
LOG_FORMAT=
# true exports prompts and completions in agent traces.
OTEL_INCLUDE_CONTENT=

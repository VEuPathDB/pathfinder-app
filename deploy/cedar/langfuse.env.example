# The Langfuse units read this file as ~/.config/pathfinder/langfuse.env. The
# application units never read it. Generate every secret on the host, for
# example with `openssl rand -hex 32`, and never reuse a value from env.example
# except the two project keys named below.

# ---- Langfuse's own PostgreSQL (pathfinder-langfuse-db) ----
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=
POSTGRES_DB=langfuse
# The same user, password and database, as the URL Langfuse connects with.
DATABASE_URL=postgresql://langfuse:<POSTGRES_PASSWORD>@pathfinder-langfuse-db:5432/langfuse

# ---- ClickHouse (pathfinder-langfuse-clickhouse); the server and Langfuse read both ----
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=

# ---- MinIO (pathfinder-langfuse-minio) ----
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=
# The same user and password, as the keys Langfuse writes events and media with.
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=

# ---- Redis (pathfinder-langfuse-redis); the server requires it and Langfuse sends it ----
REDIS_AUTH=

# ---- Langfuse web and worker ----
# Salts API key hashes: openssl rand -hex 32.
SALT=
# Encrypts stored secrets; exactly 64 hex characters: openssl rand -hex 32.
ENCRYPTION_KEY=
# Signs UI sessions: openssl rand -hex 32.
NEXTAUTH_SECRET=

# ---- Headless first start: the organization, project, keys and login ----
# Read once, when the database is empty; the UI needs no setup clicks.
LANGFUSE_INIT_ORG_ID=pathfinder
LANGFUSE_INIT_ORG_NAME=PathFinder
LANGFUSE_INIT_PROJECT_ID=pathfinder-cedar
LANGFUSE_INIT_PROJECT_NAME=PathFinder cedar
# The same two values as LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY in .env.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
# The first login to the Langfuse UI.
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# ---- Left at Langfuse's own defaults ----
# The units set every other variable Langfuse's self-host compose sets. These
# stay unset, so Langfuse uses its default:
#   LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES   off: no preview features in the UI.
#   LANGFUSE_JSON_BAD_UNICODE_ESCAPE        unset: invalid escapes in ingested JSON are kept as sent.
#   LANGFUSE_USE_OCI_NATIVE_OBJECT_STORAGE,
#   LANGFUSE_OCI_AUTH_TYPE                  off: the object store is the MinIO unit, over S3.
#   LANGFUSE_S3_BATCH_EXPORT_*              unused: the units set LANGFUSE_S3_BATCH_EXPORT_ENABLED=false.
#   LANGFUSE_INGESTION_QUEUE_DELAY_MS,
#   LANGFUSE_INGESTION_CLICKHOUSE_WRITE_INTERVAL_MS
#                                           Langfuse's batching delays for ingestion.
#   LANGFUSE_BULLMQ_SKIP_REDIS_VERSION_CHECK
#                                           off: Langfuse checks the Redis version at start.
#   REDIS_TLS_CA, REDIS_TLS_CERT, REDIS_TLS_KEY
#                                           unused: the units set REDIS_TLS_ENABLED=false.
#   EMAIL_FROM_ADDRESS, SMTP_CONNECTION_URL unset: Langfuse sends no invitation or reset mail.
# The media endpoint names the MinIO unit on the pod network. PathFinder uploads
# no media through the Langfuse SDK, so no browser needs to reach that endpoint.

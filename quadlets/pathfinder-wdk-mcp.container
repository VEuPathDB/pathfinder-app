[Unit]
Description=Pathfinder veupathdb-wdk-mcp server
After=pathfinder-db.service
Requires=pathfinder-db.service

[Container]
ContainerName=pathfinder-wdk-mcp
Image=ghcr.io/veupathdb/pathfinder-wdk-mcp:__PATHFINDER_TAG__
Network=pathfinder.network
# The api and the worker reach this server by container name, so it publishes
# no host port.
PodmanArgs=--memory=2g

Volume=pathfinder-catalogs.volume:/app/data/catalogs
# The QA sites this stack serves, from the file the installer copies. Cedar
# serves those sites on its own address, which a rootless container reaches
# only through the host alias.
Volume=%h/.config/pathfinder/sites-qa.yml:/etc/pathfinder/sites.yml:ro,z
Environment=VEUPATHDB_SITES_CONFIG=/etc/pathfinder/sites.yml
AddHost=qa.amoebadb.org:169.254.1.2
AddHost=qa.cryptodb.org:169.254.1.2
AddHost=qa.fungidb.org:169.254.1.2
AddHost=qa.giardiadb.org:169.254.1.2
AddHost=qa.hostdb.org:169.254.1.2
AddHost=qa.microsporidiadb.org:169.254.1.2
AddHost=qa.orthomcl.org:169.254.1.2
AddHost=qa.piroplasmadb.org:169.254.1.2
AddHost=qa.plasmodb.org:169.254.1.2
AddHost=qa.toxodb.org:169.254.1.2
AddHost=qa.trichdb.org:169.254.1.2
AddHost=qa.tritrypdb.org:169.254.1.2
AddHost=qa.vectorbase.org:169.254.1.2
AddHost=qa.veupathdb.org:169.254.1.2
# The directory the three services exchange catalog snapshots through.
Environment=CATALOG_CACHE_DIR=/app/data/catalogs

# API keys and app settings loaded from .env
EnvironmentFile=%h/.config/pathfinder/.env

# Infrastructure URLs, which must use container network hostnames, override .env
Environment=DATABASE_URL=postgresql+asyncpg://postgres:postgres@pathfinder-db:5432/pathfinder

# Only the api rebuilds a stale catalog; this server reads the saved snapshot
Environment=CATALOG_REFRESH_ENABLED=false
# Only the api writes embedding vectors; this server searches what the api wrote
Environment=EMBEDDING_INDEX_SYNC_ENABLED=false

# Every process that writes or matches a helper strategy reads the same prefix.
# A process on the library default recognises none of the strategies already in
# a researcher's account.
Environment=VEUPATHDB_INTERNAL_STRATEGY_NAME_PREFIX=__pathfinder_internal__:

HealthCmd=curl -fsS http://localhost:8100/health || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=10s
HealthRetries=3

[Service]
Restart=always

[Install]
WantedBy=default.target

[Unit]
Description=Pathfinder API server
After=pathfinder-db.service
Requires=pathfinder-db.service

[Container]
ContainerName=pathfinder-api
Image=ghcr.io/veupathdb/pathfinder-api:__PATHFINDER_TAG__
Network=pathfinder.network
# The reverse proxy and the SSH tunnel both reach this port on the loopback
# interface.
PublishPort=127.0.0.1:8010:8000

# API keys and app settings loaded from .env
EnvironmentFile=%h/.config/pathfinder/.env

Volume=pathfinder-catalogs.volume:/app/data/catalogs
# The directory the three services exchange catalog snapshots through.
Environment=CATALOG_CACHE_DIR=/app/data/catalogs

# Infrastructure URLs, which must use container network hostnames, override .env
Environment=DATABASE_URL=postgresql+asyncpg://postgres:postgres@pathfinder-db:5432/pathfinder
# The two tool servers this deployment admits, on the container network. A
# compose service name does not resolve here.
Environment=PATHFINDER_WDK_MCP_URL=http://pathfinder-wdk-mcp:8100/mcp
Environment=PATHFINDER_RESEARCH_MCP_URL=http://pathfinder-research-mcp:8110/mcp
# The port is bound to the host's loopback, so only the proxy or a tunnel can
# reach it: every forwarder is trusted.
Environment=FORWARDED_ALLOW_IPS=*

# Every process that writes or matches a helper strategy reads the same prefix.
# A process on the library default recognises none of the strategies already in
# a researcher's account.
Environment=VEUPATHDB_INTERNAL_STRATEGY_NAME_PREFIX=__pathfinder_internal__:
# Uncomment to use a local Ollama instance on the host
# Environment=OLLAMA_BASE_URL=http://host.containers.internal:11434/v1

HealthCmd=curl -fsS http://localhost:8000/health || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=600s
HealthRetries=3

[Service]
Restart=always

[Install]
WantedBy=default.target

[Unit]
Description=Pathfinder web frontend
After=pathfinder-api.service
Requires=pathfinder-api.service

[Container]
ContainerName=pathfinder-web
Image=ghcr.io/veupathdb/pathfinder-web:__PATHFINDER_TAG__
Network=pathfinder.network
# The reverse proxy and the SSH tunnel both reach this port on the loopback
# interface.
PublishPort=127.0.0.1:3010:3000
# The api address is baked into the image at build time and read on the server
# only, so this unit states none.

[Service]
Restart=always

[Install]
WantedBy=default.target

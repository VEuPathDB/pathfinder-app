# PathFinder strict/base profile
#
# Copy to `.env` and fill in every required value:
#   cp .env.example .env
#
# This file is for production/staging-style startup. Local-development
# conveniences live in `.env.dev.example` and the `*.dev.yml` overlays.

# ── Core runtime (required) ──────────────────────────────────────────────────
API_ENV=production
API_SECRET_KEY=
DATABASE_URL=
# Docker Compose: http://api:8000
# Direct web run: http://localhost:8000
NEXT_PUBLIC_API_URL=

# ── Model backend (required)
# Set PATHFINDER_CHAT_PROVIDER=default and configure at least one provider
# or an explicit Ollama base URL. Mock mode is test-only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=
PATHFINDER_CHAT_PROVIDER=
DEFAULT_PROVIDER=anthropic
DEFAULT_TIER=default

# ── Security (optional) ─────────────────────────────────────────────────────
# Set to false to skip the injection judge on the user's message and on every
# tool result. Defaults to true.
INPUT_SCREENING_ENABLED=true

# The model one judgement runs on.
INPUT_SCREENING_MODEL=openai:gpt-5.6-luna

# OAuth server whose JWKS verifies VEuPathDB bearer tokens. One server serves
# every site. Defaults to https://auth.veupathdb.org.
VEUPATHDB_OAUTH_URL=

# Application identities for service-to-service callers, as
# "app_id:secret[,app_id:secret...]". Each secret needs 32+ characters. A caller
# sends its secret in the X-PathFinder-Service-Token header. Empty = none.
PATHFINDER_SERVICE_TOKENS=

# The prefix this deployment tags the helper strategies it creates in a WDK
# account with. Every process that writes or matches one must read the same
# value: the api, the worker and the wdk-mcp container. The library default
# names no product, and a process on it recognises none of the strategies this
# deployment has already written.
VEUPATHDB_INTERNAL_STRATEGY_NAME_PREFIX=__pathfinder_internal__:

# ── MCP tool servers ────────────────────────────────────────────────────────
# What the veupathdb-wdk-mcp server reads. WDK_MCP_BASE_URL is the URL a client
# fetches its RFC 9728 document at, so it must be reachable by the client.
# WDK_MCP_SERVICE_TOKENS admits applications without a VEuPathDB user, as
# "app_id:secret[,app_id:secret...]"; empty admits user bearers only.
MCP_PORT=8100
WDK_MCP_BASE_URL=http://localhost:8100
WDK_MCP_SERVICE_TOKENS=

# What the veupathdb-research-mcp server reads. It holds no account and no
# database. An empty RESEARCH_MCP_SERVICE_TOKENS admits nothing.
RESEARCH_MCP_PORT=8110
RESEARCH_MCP_BASE_URL=http://localhost:8110
RESEARCH_MCP_SERVICE_TOKENS=
# A mailbox Crossref reads out of the User-Agent, which routes the call to its
# polite pool. Empty keeps the anonymous pool.
RESEARCH_MCP_CROSSREF_MAILTO=
# Brave Search API (https://brave.com/search/api/, Search plan: $5 per 1,000 requests,
# $5 of free credit a month, a card on file). With a key Brave answers web searches
# first and the scraped engines are the fallback; each answered call is charged to the
# user's monthly budget at RESEARCH_MCP_BRAVE_SEARCH_COST_USD (default 0.005).
RESEARCH_MCP_BRAVE_SEARCH_API_KEY=
# The SearXNG metasearch the research server asks first (deploy/searxng/settings.yml).
# SEARXNG_SECRET signs its cookies inside the stack: any long random string.
SEARXNG_SECRET=
RESEARCH_MCP_SEARXNG_URL=http://searxng:8080

# The endpoints this deployment's assistants call, and the credential presented
# at each. An empty token admits no source, and a turn runs without its tools.
PATHFINDER_WDK_MCP_URL=http://wdk-mcp:8100/mcp
PATHFINDER_WDK_MCP_TOKEN=
PATHFINDER_RESEARCH_MCP_URL=http://research-mcp:8110/mcp
PATHFINDER_RESEARCH_MCP_TOKEN=

# ── VEuPathDB sites (optional) ───────────────────────────────────────
# Budget for one site's catalog load, at startup and on every retry. A site
# that does not answer inside it is degraded: named in /health/ready, refused
# on its own routes, and retried. Minimum 1. Defaults to 30.
SITE_PRELOAD_TIMEOUT_SECONDS=30

# Seconds between two passes over the degraded sites. Minimum 1. Defaults to 60.
SITE_RETRY_INTERVAL_SECONDS=60

# ── Background worker (optional) ────────────────────────────────────────────
# Jobs the Procrastinate worker runs in parallel, across every queue.
WORKER_CONCURRENCY=4

# Age at which a job still in 'doing' is failed so its lock releases and the
# chat stream it left open ends. Minimum 300. Defaults to 3600.
WORKER_STALLED_JOB_TIMEOUT_SECONDS=3600

# ── Chat turns (optional) ───────────────────────────────────────────────────
# Tokens the Lead's own run may spend in one turn. A FRAME, BUILD or VERIFY
# pass runs under a ceiling of its own and is not counted here. A run that
# reaches it ends with a reply naming the budget. Minimum 1. Defaults to
# 600000. A turn the Lead classifies as off-topic stops at a lower ceiling.
LEAD_TURN_TOKEN_LIMIT=600000

# ── Chat SSE (optional) ─────────────────────────────────────────────────────
# Seconds of silence after which the chat SSE stream sends a comment frame, so
# a proxy or a browser does not drop an idle stream. Minimum 1. Defaults to 15.
SSE_KEEPALIVE_SECONDS=15

# ── Observability (optional, but explicit when enabled) ─────────────────────
# Set to true to export prompts, completions, and tool arguments in agent
# traces. Defaults to false.
OTEL_INCLUDE_CONTENT=false

# External/production SigNoz
SIGNOZ_OTEL_ENDPOINT=
SIGNOZ_TRACE_OTEL_HTTP_ENDPOINT=

# Optional self-hosted SigNoz bootstrap values
SIGNOZ_TOKENIZER_JWT_SECRET=
SIGNOZ_ROOT_USER_EMAIL=
SIGNOZ_ROOT_USER_PASSWORD=
# Development/local-only ClickHouse shortcut for self-hosted SigNoz.
SIGNOZ_CLICKHOUSE_SKIP_USER_SETUP=

# External/production Langfuse
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Self-hosted observability overrides (only for docker-compose.observability.dev.yml)
LANGFUSE_POSTGRES_USER=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_POSTGRES_DB=
LANGFUSE_CLICKHOUSE_USER=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_ROOT_USER=
LANGFUSE_MINIO_ROOT_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# ── Research / site integrations (optional) ─────────────────────────────────
# VEUPATHDB_SITES_CONFIG=/path/to/my-sites.yaml
S2_API_KEY=

# Researchers' own provider keys (optional). Seals each key a researcher enters;
# empty means this deployment takes none. Generate it once and keep it: a new
# value makes every stored key unreadable.
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PROVIDER_KEY_ENCRYPTION_KEY=

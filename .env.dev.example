# PathFinder development profile
#
# Usage:
#   cp .env.dev.example .env.dev
#   docker compose --env-file .env.dev -f docker-compose.yml -f docker-compose.dev.yml up --build
#
# This file is intentionally local-development only. The strict/base profile
# lives in `.env.example`.

# Core runtime
API_ENV=development
API_SECRET_KEY=pathfinder-dev-secret-key-change-me-1234567890
# Development runs require a real provider path. Set to `default`.
# Mock mode lives in docker-compose.e2e.yml (see README Option C).
PATHFINDER_CHAT_PROVIDER=default
NEXT_PUBLIC_API_URL=http://api:8000

# Local containers
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/pathfinder

# Registered VEuPathDB login the chat debugger signs in with. Every WDK-backed
# call needs one; a run without them is refused unless it is a --mock run.
WDK_DEV_EMAIL=
WDK_DEV_PASSWORD=

# Optional real-model overrides for development
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
DEFAULT_PROVIDER=anthropic
DEFAULT_TIER=balanced

# Optional local observability overrides for direct host runs
SIGNOZ_OTEL_ENDPOINT=http://signoz-otel-collector:4317
SIGNOZ_TRACE_OTEL_HTTP_ENDPOINT=http://signoz-otel-collector:4318/v1/traces
SIGNOZ_TOKENIZER_JWT_SECRET=pathfinder-local-signoz-jwt-secret
SIGNOZ_ROOT_USER_EMAIL=dev@pathfinder.local
SIGNOZ_ROOT_USER_PASSWORD=PathfinderLocal1!
SIGNOZ_CLICKHOUSE_SKIP_USER_SETUP=1

LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-pathfinder-local-dev
LANGFUSE_SECRET_KEY=sk-lf-pathfinder-local-dev
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=langfuse
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
LANGFUSE_MINIO_ROOT_USER=minio
LANGFUSE_MINIO_ROOT_PASSWORD=miniosecret
LANGFUSE_REDIS_AUTH=myredissecret
LANGFUSE_NEXTAUTH_SECRET=pathfinder-local-nextauth-secret
LANGFUSE_INIT_ORG_ID=pathfinder-local
LANGFUSE_INIT_ORG_NAME=PathFinder
LANGFUSE_INIT_PROJECT_ID=pathfinder-local-project
LANGFUSE_INIT_PROJECT_NAME=PathFinder Local
LANGFUSE_INIT_USER_EMAIL=dev@pathfinder.local
LANGFUSE_INIT_USER_NAME=PathFinder Dev
LANGFUSE_INIT_USER_PASSWORD=pathfinder-local-dev
LANGFUSE_SALT=pathfinder-local-salt
LANGFUSE_ENCRYPTION_KEY=7ad57e4f76d1ad8e3fa73b3a81c9f0ab998d0b9b148a2fa6cd762fce6e8736cb
